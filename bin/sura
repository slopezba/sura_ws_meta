#!/usr/bin/env bash
set -euo pipefail

APP_NAME="SURA"
CONFIG_DIR_NAME=".sura"
CONFIG_FILE_NAME="sura.env"
COMPOSE_FILE_NAME="docker-compose.yml"

print_header() {
  echo "============================================================"
  echo " $APP_NAME Robot Runtime"
  echo "============================================================"
}

print_error() {
  echo "Error: $*" >&2
}

print_info() {
  echo "$*"
}

resolve_sura_home() {
  local source_path="${BASH_SOURCE[0]}"

  while [ -L "$source_path" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" != /* ]] && source_path="$dir/$source_path"
  done

  local script_dir
  script_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"

  cd "$script_dir/.." >/dev/null 2>&1
  pwd
}

SURA_HOME="$(resolve_sura_home)"
CONFIG_DIR="$SURA_HOME/$CONFIG_DIR_NAME"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_FILE_NAME"
COMPOSE_FILE="$SURA_HOME/$COMPOSE_FILE_NAME"

export SURA_HOME

compose() {
  cd "$SURA_HOME"
  docker compose \
    --project-directory "$SURA_HOME" \
    -f "$COMPOSE_FILE" \
    "$@"
}

require_workspace() {
  if [ ! -f "$COMPOSE_FILE" ]; then
    print_error "docker-compose.yml was not found in $SURA_HOME"
    exit 1
  fi

  if [ ! -f "$SURA_HOME/scripts/sura-entrypoint.sh" ]; then
    print_error "scripts/sura-entrypoint.sh was not found in $SURA_HOME"
    exit 1
  fi
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    print_error "Docker is not installed or not available in PATH."
    exit 1
  fi

  if ! docker compose version >/dev/null 2>&1; then
    print_error "Docker Compose plugin is not available."
    exit 1
  fi
}

validate_robot_name() {
  local value="$1"

  [[ "$value" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]]
}

validate_ros_domain_id() {
  local value="$1"

  [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -ge 0 ] && [ "$value" -le 101 ]
}

select_dds() {
  local choice

  echo
  echo "Select DDS middleware:"
  echo "  1) CycloneDDS"
  echo "  2) FastDDS"
  echo

  while true; do
    read -rp "Choice [1/2]: " choice

    case "$choice" in
      1)
        SURA_DDS="cyclonedds"
        RMW_IMPLEMENTATION="rmw_cyclonedds_cpp"
        return
        ;;
      2)
        SURA_DDS="fastdds"
        RMW_IMPLEMENTATION="rmw_fastrtps_cpp"
        return
        ;;
      *)
        echo "Invalid option. Please choose 1 or 2."
        ;;
    esac
  done
}

configure_runtime() {
  local robot_name
  local ros_domain_id

  mkdir -p "$CONFIG_DIR"

  print_header
  echo "Initial runtime configuration"
  echo

  while true; do
    read -rp "Robot name, e.g. blueboat_01: " robot_name

    if validate_robot_name "$robot_name"; then
      break
    fi

    echo "Invalid robot name."
    echo "Use letters, numbers, hyphens or underscores. The name must start with a letter."
    echo
  done

  while true; do
    read -rp "ROS_DOMAIN_ID [0-101], e.g. 23: " ros_domain_id

    if validate_ros_domain_id "$ros_domain_id"; then
      break
    fi

    echo "Invalid ROS_DOMAIN_ID. Please use a number between 0 and 101."
    echo
  done

  select_dds

  local robot_namespace="/$robot_name"

  cat > "$CONFIG_FILE" <<EOF
SURA_ROBOT_NAME=$robot_name
SURA_ROBOT_NAMESPACE=$robot_namespace
ROS_DOMAIN_ID=$ros_domain_id
SURA_DDS=$SURA_DDS
RMW_IMPLEMENTATION=$RMW_IMPLEMENTATION
EOF

  echo
  echo "Configuration saved:"
  echo "  $CONFIG_FILE"
  echo
}

ensure_config_exists() {
  if [ ! -f "$CONFIG_FILE" ]; then
    configure_runtime
  fi
}

show_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "SURA is not configured yet."
    echo
    echo "Run:"
    echo "  sura setup"
    return
  fi

  cat "$CONFIG_FILE"
}

start_runtime() {
  require_workspace
  require_docker
  ensure_config_exists

  echo "Starting SURA..."
  echo "Workspace: $SURA_HOME"
  echo

  compose up -d

  echo
  echo "SURA is running."
  echo
  echo "Useful commands:"
  echo "  sura status"
  echo "  sura logs"
  echo "  sura shell"
}

stop_runtime() {
  require_workspace
  require_docker

  echo "Stopping SURA..."
  echo "Workspace: $SURA_HOME"
  echo

  compose down

  echo
  echo "SURA has been stopped."
}

restart_runtime() {
  require_workspace
  require_docker
  ensure_config_exists

  echo "Restarting SURA..."
  echo

  compose down
  compose up -d

  echo
  echo "SURA has been restarted."
}

run_doctor() {
  print_header
  echo "System check"
  echo

  echo "Workspace:"
  echo "  $SURA_HOME"
  echo

  if [ -f "$COMPOSE_FILE" ]; then
    echo "[OK] docker-compose.yml found"
  else
    echo "[FAIL] docker-compose.yml not found"
  fi

  if [ -f "$SURA_HOME/scripts/sura-entrypoint.sh" ]; then
    echo "[OK] scripts/sura-entrypoint.sh found"
  else
    echo "[FAIL] scripts/sura-entrypoint.sh not found"
  fi

  if [ -f "$CONFIG_FILE" ]; then
    echo "[OK] runtime configuration found"
  else
    echo "[WARN] runtime configuration not found"
  fi

  if command -v docker >/dev/null 2>&1; then
    echo "[OK] Docker command found"
  else
    echo "[FAIL] Docker command not found"
  fi

  if docker compose version >/dev/null 2>&1; then
    echo "[OK] Docker Compose plugin found"
  else
    echo "[FAIL] Docker Compose plugin not found"
  fi

  echo
}

print_help() {
  cat <<EOF
SURA Robot Runtime

Usage:
  sura <command>

Commands:
  setup          Configure robot name, ROS_DOMAIN_ID and DDS middleware
  start          Start the SURA Docker runtime
  stop           Stop and remove the SURA Docker runtime
  restart        Restart the SURA Docker runtime
  status         Show Docker Compose service status
  logs           Follow runtime logs
  shell          Open an interactive shell inside the main container
  config         Show current runtime configuration
  reconfigure    Reconfigure and restart the runtime
  doctor         Check workspace, Docker and configuration
  home           Print the SURA workspace path
  help           Show this help message

Examples:
  sura setup
  sura start
  sura logs
  sura stop
EOF
}

main() {
  local command="${1:-help}"

  case "$command" in
    setup)
      require_workspace
      configure_runtime
      ;;

    start)
      start_runtime
      ;;

    stop)
      stop_runtime
      ;;

    restart)
      restart_runtime
      ;;

    status)
      require_workspace
      require_docker
      compose ps
      ;;

    logs)
      require_workspace
      require_docker
      compose logs -f --tail=100
      ;;

    shell)
      require_workspace
      require_docker
      compose exec main bash
      ;;

    config)
      show_config
      ;;

    reconfigure)
      require_workspace
      require_docker
      configure_runtime
      restart_runtime
      ;;

    doctor)
      run_doctor
      ;;

    home)
      echo "$SURA_HOME"
      ;;

    help|--help|-h)
      print_help
      ;;

    *)
      print_error "Unknown command: $command"
      echo
      print_help
      exit 1
      ;;
  esac
}

main "$@"
